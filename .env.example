# ---------------------------------------------------------------------------
# Fai-Clipper — Python pipeline environment
# Isi otomatis: jalankan `./scripts/init-env.sh` (lokal) atau `scripts/vps-bootstrap.sh` (VPS).
# Setelah itu edit file `.env` ini — wajib setidaknya GROQ_API_KEY untuk pipeline.
# ---------------------------------------------------------------------------
# Operator: satu set key di server Anda untuk semua user. Tidak perlu banyak key
# sekaligus — tambah GEMINI_/OPENAI_/ANTHROPIC_ saat siap; router skip yang kosong.

# ========== Pool API key LLM (opsional — sama dengan web `API_KEY_POOL_MASTER_SECRET`) ==========
# Admin bisa menambah beberapa key per vendor di dashboard; worker memutar saat 429.
# API_KEY_POOL_MASTER_SECRET=
# Durasi cooldown per key setelah 429 (detik), dan lewati cooldown di dev:
# API_KEY_COOLDOWN_SEC=120
# CLIPPER_SKIP_KEY_COOLDOWN=0
# Rotasi stabil per job (di-set oleh scripts/process-job.mjs):
# CLIPPER_JOB_ID=

# ========== LLM providers ==========
# Groq: default LLM + Whisper (wajib untuk MVP). Paid tiers fallback ke vendor
# lain hanya jika key-nya diisi.
GROQ_API_KEY=
# GROQ_LLM_MODEL=llama-3.3-70b-versatile

# Optional paid-tier providers — leave blank to disable.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- OpenAI resmi (api.openai.com) — model tanpa slash, mis. gpt-4o-mini ----------
OPENAI_API_KEY=
# OPENAI_BASE_URL=        # kosong = default OpenAI; isi jika Azure / proxy resmi
# OPENAI_MODEL=gpt-4o-mini

# --- OpenRouter (terpisah) — key sk-or-v1-..., model slug vendor/model ----------
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=https://your-site.example
# OPENROUTER_APP_TITLE=Fai-Clipper

# Legacy (satu jalur): OPENAI_API_KEY + OPENAI_BASE_URL=https://openrouter.ai/api/v1
# masih didukung; disarankan pindah ke OPENROUTER_* di atas.

# Anthropic (Claude): API key dari https://console.anthropic.com/ — opsional.
# Kalau kosong, router tidak akan memanggil Claude. Dipakai tier Pro (rantai LLM)
# dan saat user memilih "Anthropic" di Settings.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# DeepSeek: pakai OpenRouter — OPENROUTER_API_KEY + model `deepseek/deepseek-chat`.

# ========== Whisper (transcription) ==========
# Groq Whisper Large v3 Turbo is 20–30× faster than CPU faster-whisper
# and free for reasonable volume. Falls back to CPU if API fails.
PREFER_GROQ_WHISPER=1
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Local fallback model size (tiny | base | small | medium | large-v2).
WHISPER_MODEL_SIZE=small

# ========== Clip shaping ==========
# Default untuk worker CLI. Di dashboard, tiap job bisa override lewat form
# (API mengirim CLIP_MIN_DURATION / CLIP_MAX_DURATION ke process child).
CLIP_MIN_DURATION=20
CLIP_MAX_DURATION=90
MAX_CLIPS=8

# ========== Render ==========
# Layout output (CLI/worker default). Di dashboard, tiap job memilih lewat form:
#   short_vertical = 9:16 (1080×1920) standar Shorts / Reels / TikTok
#   long_horizontal = 16:9 (1920×1080) standar YouTube / video horizontal
# API mengirim CLIPPER_OUTPUT_LAYOUT per job (override nilai di bawah).
# CLIPPER_OUTPUT_LAYOUT=short_vertical
# Windows: FFmpeg drawtext watermark kadang crash tanpa font eksplisit — set path font .ttf:
# FFMPEG_DRAW_TEXT_FONT=C:/Windows/Fonts/arial.ttf
# Resolusi vertikal (hanya untuk short_vertical):
# VERTICAL_OUT_W=1080
# VERTICAL_OUT_H=1920

# Watermark di video (bukan subtitle — teks posting/caption hanya di dashboard):
# WATERMARK_TEXT=              # jika diisi: memaksa teks watermark untuk semua tier (operator).
# Free: watermark wajib di file MP4 (default nama produk).
# FREE_TIER_WATERMARK_TEXT=Fai-Clipper
# FREE_TIER_WATERMARK_POSITION=bottom_right
# Berbayar: video bersih kecuali user mengaktifkan watermark di profil — API job mengisi:
# WATERMARK_PAID_ENABLED / WATERMARK_CUSTOM_TEXT (jangan set manual kecuali debug).
# WATERMARK_POSITION=bottom_right
#   (top_left | top_right | bottom_left | bottom_right | center)

# ========== Timeouts ==========
PIPELINE_TIMEOUT_SEC=3600
FFMPEG_TIMEOUT_SEC=1200

# ========== Observability (optional) ==========
# SENTRY_DSN=

# ========== Paths ==========
# Absolute path to the repository root (folder containing clipper/).
# Worker uses this to resolve the Python module and output dir.
# Docker compose bind-mounts /data/output instead.
# CLIPPER_OUTPUT=output

# ========== AI Generator (Phase 3) ==========
# Urutan fallback provider AI; jika kosong, ambil dari tabel ai_provider_config.
# AI_PROVIDER_ORDER=openrouter,mock
# Endpoint custom OpenRouter image/video gateway (opsional).
# OPENROUTER_IMAGE_ENDPOINT=
# OPENROUTER_IMAGE_MODEL=openrouter/auto


# Gateway endpoint internal untuk worker AI (opsional; default bisa OPENROUTER_IMAGE_ENDPOINT).
# AI_GATEWAY_ENDPOINT=http://127.0.0.1:3000/api/ai/gateway
# Secret shared antara worker -> gateway route (opsional tapi disarankan):
# AI_GATEWAY_SHARED_SECRET=change-me-strong
# Model image OpenAI untuk gateway direct call:
# OPENAI_IMAGE_MODEL=gpt-image-1

