# ---------------------------------------------------------------------------
# Fai-Clipper — Next.js (`web/`) — target file: `.env.local` (dibuat oleh init-env.sh)
# Next hanya memuat file ini + env sistem; root `.env` TIDAK otomatis dibaca
# oleh `next dev`. Worker `scripts/process-job.mjs` memuat:
#   1) `<repo>/.env`   2) `web/.env.local`   (nilai di langkah 2 menimpa)
# Otomatis: `./scripts/init-env.sh` atau `scripts/vps-bootstrap.sh` mengisi path
# (CLIPPER_REPO_ROOT, PYTHON_BIN, CLIPPER_OUTPUT). Anda hanya mengisi Supabase & API key.
# ---------------------------------------------------------------------------

# ========== Supabase (wajib untuk dashboard + API) ==========
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# URL publik app (opsional). Produksi: https://sayai.online — dipakai tautan reset password
# (forgot-password) agar redirectTo konsisten. Lokal: kosongkan (pakai window.location.origin).
# NEXT_PUBLIC_SITE_URL=https://sayai.online
#
# Supabase Dashboard → Authentication → URL configuration (WAJIB disesuaikan per lingkungan):
#   Lokal — Site URL: http://localhost:3000
#           Additional Redirect URLs: http://localhost:3000/auth/callback
#   Produksi — Site URL: https://sayai.online   (bukan localhost; kalau salah, email magic link
#              dan recovery bisa mengarah ke http://localhost:3000)
#           Additional Redirect URLs:
#              https://sayai.online/auth/callback
#              https://sayai.online/**

# ========== Repo & worker spawn (wajib untuk job dari dashboard) ==========
CLIPPER_REPO_ROOT=C:/path/to/AI-Video-Clipper
PYTHON_BIN=python
# CLIPPER_OUTPUT=C:/path/to/AI-Video-Clipper/output

# ========== Uploads ==========
MAX_UPLOAD_MB=2048

# ========== LLM — dipakai refresh katalog + diteruskan ke proses worker ==========
GROQ_API_KEY=
GEMINI_API_KEY=
# OpenAI resmi (gpt-* tanpa slash)
OPENAI_API_KEY=
# OPENAI_BASE_URL=     # opsional; jangan isi URL OpenRouter di sini
# OpenRouter (key terpisah, model slug vendor/model)
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=

# Pool stok key (admin) — sama persis di root `.env` agar worker bisa dekripsi (min 12 karakter).
API_KEY_POOL_MASTER_SECRET=

# ========== Cron: refresh katalog model (opsional) ==========
# Isi agar GET /api/cron/refresh-llm-models tidak 503. Contoh lokal:
# CRON_SECRET=local-dev-ganti-ini
# curl -H "Authorization: Bearer local-dev-ganti-ini" http://localhost:3000/api/cron/refresh-llm-models
# Tanpa secret: tetap bisa POST /api/admin/refresh-llm-models (admin).
CRON_SECRET=
# Cron tambahan (lihat web/vercel.json): llm-key-health setiap 5 menit, storage harian.
# curl -H "Authorization: Bearer $CRON_SECRET" http://localhost:3000/api/cron/llm-key-health
# curl -H "Authorization: Bearer $CRON_SECRET" http://localhost:3000/api/cron/storage-snapshot

# Alert email (Resend) bila semua key satu provider tidak sehat:
# RESEND_API_KEY=
# RESEND_ALERT_FROM="Clipper <onboarding@resend.dev>"
# OPERATOR_ALERT_EMAIL=you@example.com

# Perkiraan biaya storage Supabase (USD per GB-bulan, angka kasar untuk tampilan admin):
# SUPABASE_STORAGE_USD_PER_GB=0.021
# Estimasi byte disk worker (opsional, laporan manual/metrik agen):
# WORKER_DISK_USAGE_BYTES=

# ========== Observability (opsional) ==========
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENV=development

# ========== Cloudflare Turnstile (opsional — login & daftar) ==========
# Buat site + secret di Cloudflare Dashboard → Turnstile.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x...
# TURNSTILE_SECRET_KEY=0x...

# ========== Tautan sosial (opsional — footer & halaman auth) ==========
# NEXT_PUBLIC_SOCIAL_FACEBOOK_URL=https://www.facebook.com/yourpage
# NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=https://www.instagram.com/yourprofile

# ========== Admin seed (SQL) ==========
# Dipakai migrasi seed admin — bukan dibaca runtime oleh Next.
ADMIN_EMAILS=you@example.com

# ========== Worker / pipeline (override; default utamanya di `<repo>/.env`) ==========
# Disalin ke sini agar `next dev` + spawn worker punya env yang sama tanpa duplikasi penuh.
# Lihat juga `.env.example` di root.

ANTHROPIC_API_KEY=
# DeepSeek: tidak ada DEEPSEEK_API_KEY — pakai OpenRouter (OPENAI_BASE_URL + OPENAI_API_KEY + slug model deepseek/...).

# Whisper
PREFER_GROQ_WHISPER=1
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
WHISPER_MODEL_SIZE=small

# Default clip (job dari dashboard bisa override)
CLIP_MIN_DURATION=20
CLIP_MAX_DURATION=90
MAX_CLIPS=8

# Timeout pipeline / ffmpeg
PIPELINE_TIMEOUT_SEC=3600
FFMPEG_TIMEOUT_SEC=1200

# Tier & batas (default worker CLI; job RPC mengisi USER_TIER per job)
USER_TIER=free
MAX_SOURCE_DURATION_SEC=3600
# WATERMARK_TEXT=              # override teks watermark semua tier (opsional)
# FREE_TIER_WATERMARK_TEXT=Fai-Clipper
# FREE_TIER_WATERMARK_POSITION=bottom_right
# WATERMARK_POSITION=bottom_right

# Opsional model LLM per vendor (override default di kode)
# GROQ_LLM_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Render (lihat `.env.example` di root). Job dari dashboard: jenis output (9:16 vs 16:9)
# dipilih user per job — API mengirim CLIPPER_OUTPUT_LAYOUT ke worker.
# CLIPPER_OUTPUT_LAYOUT=short_vertical
# VERTICAL_OUT_W=1080
# VERTICAL_OUT_H=1920

# Skrip purge lama (`web/scripts/purge-old-jobs.mjs`)
RETENTION_DAYS=10

# Opsional: mirror URL (beberapa tooling memakai nama ini). Next + process-job.js memakai NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=

# Jarang perlu — process-job mengisi JOB_EVENTS_* untuk proses Python.
JOB_EVENTS_URL=

# ========== Binary kustom (produksi) ==========
# FFMPEG_PATH=/usr/bin/ffmpeg
# YT_DLP_PATH=/usr/local/bin/yt-dlp

# ========== AI Generator (Phase 3) ==========
# AI provider fallback order override (opsional):
# AI_PROVIDER_ORDER=openrouter,mock
# OpenRouter adapter endpoint (opsional, jika ingin provider nyata):
# OPENROUTER_IMAGE_ENDPOINT=
# OPENROUTER_IMAGE_MODEL=openrouter/auto


# Gateway endpoint internal (worker -> Next API):
# AI_GATEWAY_ENDPOINT=http://127.0.0.1:3000/api/ai/gateway
# Secret optional untuk authorize worker request ke gateway:
# AI_GATEWAY_SHARED_SECRET=change-me-strong
# OpenAI image model (dipakai route /api/ai/gateway bila OPENAI_API_KEY tersedia):
# OPENAI_IMAGE_MODEL=gpt-image-1

